{
  "name": "lyra-desktop",
  "productName": "Lyra",
  "version": "2.0.0",
  "description": "Lyra - เครื่องมือแก้ไข PDF ทำงานในเครื่อง 100% (Desktop)",
  "main": "main.js",
  "author": "ASCGroup",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync-web.js",
    "start": "npm run sync && electron .",
    "pack": "node scripts/pack.js",
    "dist": "npm run sync && electron-builder --win portable nsis --x64"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "@electron/packager": "^20.3.0",
    "resedit": "^2.0.3"
  },
  "build": {
    "appId": "th.co.ascgroup.lyra",
    "productName": "Lyra",
    "executableName": "Lyra",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "web",
        "to": "web"
      }
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "Lyra-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Lyra-Setup-${version}.exe",
      "shortcutName": "Lyra"
    }
  }
}